/* 「安芯」全局样式 —— 配色取自项目文档的深蓝 (#1F3B57) */

page {
  background: #F5F7FA;
  color: #1F2933;
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 30rpx;
  line-height: 1.6;
}

.page {
  padding: 32rpx 28rpx 64rpx;
}

.h1 {
  font-size: 40rpx;
  font-weight: 700;
  color: #1F3B57;
  margin-bottom: 8rpx;
}

.sub {
  font-size: 26rpx;
  color: #7B8794;
  margin-bottom: 32rpx;
}

.card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(31, 59, 87, 0.06);
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1F3B57;
  margin-bottom: 12rpx;
}

.muted {
  color: #7B8794;
  font-size: 26rpx;
}

.tag {
  display: inline-block;
  font-size: 24rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  background: #EAF1F8;
  color: #1F3B57;
  margin-right: 12rpx;
}

.footer {
  margin-top: 48rpx;
  text-align: center;
  font-size: 22rpx;
  color: #B0B8C4;
}

.next {
  background: #FFF8E6;
  border-left: 8rpx solid #E6A23C;
  color: #8A6116;
  font-size: 26rpx;
  padding: 20rpx 24rpx;
  border-radius: 8rpx;
  margin-bottom: 24rpx;
}
